# ------------------------------------------------------------------
# Staging environment (tGBP sandbox + Solana devnet)
# Written to the server by GitHub Actions from repository secrets.
# Copy to .env.production with production values for the live variant.
# ------------------------------------------------------------------

# tGBP API key for this environment.
#   staging    -> sandbox key, starts with tgbp_sandbox_
#   production -> live key, starts with tgbp_live_
NUXT_TGBP_API_KEY=

# tGBP API base URL
#   staging    -> https://sandbox.tgbp.io
#   production -> https://api.tgbp.io
NUXT_TGBP_API_BASE_URL=https://sandbox.tgbp.io

# Chain to mint on — Solana only
#   staging    -> solana-devnet
#   production -> solana
NUXT_TGBP_CHAIN=solana-devnet

# Public (exposed to the browser)
NUXT_PUBLIC_ENV_NAME=staging
NUXT_PUBLIC_SOLANA_CLUSTER=devnet

# Optional: Solana RPC endpoint used by the browser to build/send the burn
# transaction. Defaults to the public api.devnet / api.mainnet-beta endpoints
# based on NUXT_PUBLIC_SOLANA_CLUSTER.
# NUXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional: override the tGBP mint address. By default it is resolved from the
# tGBP API's chain details (contract_address), with known fallbacks:
#   solana-devnet -> H9JAnSzaX66KioeboojT8Ng7Aw2xKLbNoCuNfWZjisYd
#   solana        -> 2zMqyX4AYCk6mgy5UZ2S7zUaLxwERhK5WjqDzkPPbSpW
# NUXT_TGBP_MINT_ADDRESS=
